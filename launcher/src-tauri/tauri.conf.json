{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VIctory S",
  "mainBinaryName": "sagouindupm-launcher",
  "version": "0.1.0",
  "identifier": "fr.sagouindupm.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sagouindupm | VIctory",
        "width": 1100,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#1B1B1B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/Sagouindupm/captures/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
