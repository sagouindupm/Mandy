<?xml version="1.0" encoding="utf-8"?>
<!-- Fake GDK package manifest for the MANDY test title. -->
<Game configVersion="1">
  <Identity Name="MANDY.TestTitle" Publisher="CN=MANDY" Version="1.0.0.0"/>
  <ExecutableList>
    <Executable Name="mandy_testtitle.exe" TargetDeviceFamily="Scarlett" Id="Game"/>
  </ExecutableList>
  <ShellVisuals DefaultDisplayName="MANDY Test Title" PublisherDisplayName="MANDY"/>
  <!-- settings MANDY takes from a title's manifest (values of a real title) -->
  <PersistentLocalStorage>
    <SizeMB>2048</SizeMB>
  </PersistentLocalStorage>
  <VirtualMachine>
    <SMTEnabled>true</SMTEnabled>
    <XboxLockhartTitleMemory>Advanced</XboxLockhartTitleMemory>
    <XboxAnacondaTitleMemory>Advanced</XboxAnacondaTitleMemory>
  </VirtualMachine>
</Game>
